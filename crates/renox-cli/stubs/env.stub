APP_NAME="{{title}}"
# local, production or testing (also dev, development, prod, test); anything else stops the app at boot.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:3000
APP_KEY={{app_key}}
# The address `serve` listens on (an IP): 0.0.0.0 in a container or behind a proxy on another host.
APP_HOST=127.0.0.1
APP_PORT=3000
# Default language. Renox's own texts are English; other languages come from
# resources/lang/<locale>.json (e.g. es.json).
# With App::detect_locale() in src/lib.rs, a visitor's browser language wins when the app has it.
APP_LOCALE=en
# Currency of the `money` template filter and the data grid's money columns
# (ISO 4217): USD shows $75.00, EUR €75.00, IDR Rp 75,000.
APP_CURRENCY=USD

# SQLite: sqlite://storage/app.db (the file is created on first use).
# PostgreSQL: postgres://user:password@host:5432/database (renox's `postgres`
# feature; create the database first).
DATABASE_URL={{database_url}}
# Connections kept open (at least 1).
DATABASE_POOL_SIZE=8
# Tests (renox::testing::TestApp) use an in-memory SQLite database, or a fresh
# schema in this PostgreSQL database when it's set.
{{test_database_url}}

# `log` writes emails (password reset, verification links) to the server log;
# with APP_DEBUG on they're also listed at /_renox/mail. Use `smtp` in production
# (`memory` keeps them in memory, for tests). One of log, smtp or memory.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# tls (usually port 465), starttls (usually 587) or none.
MAIL_ENCRYPTION=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
# The sender's name; APP_NAME when unset.
# MAIL_FROM_NAME=
# Mailers to try in order when this one fails, by the names given to
# App::mailer in src/lib.rs (e.g. a second SMTP provider read from BACKUP_*).
# MAIL_FAILOVER=backup

# Background jobs and scheduled tasks run inside `serve`. Several servers can
# share one database: each job and each scheduled run is taken by one of them.
QUEUE_WORKERS=2
SCHEDULER=true
# Outbound webhooks: an endpoint is disabled after this many failed deliveries in a row.
# WEBHOOK_DISABLE_AFTER=20
# Signed requests (SignedRequest) are refused when their timestamp is further than this many seconds off.
# WEBHOOK_TOLERANCE_SECS=300
# Time zone of scheduled tasks and dates: an IANA zone (Asia/Jakarta), an offset (+07:00) or UTC.
APP_TIMEZONE=UTC

# `memory` or `database`. With several servers use `database`: the cache, rate
# limits, the login lock and cache locks are then shared by all of them (and by
# queue:work). With `memory`, a lock only holds within one process.
CACHE_STORE=memory

# `cookie` (the whole session in an encrypted cookie, up to ~4 KB) or
# `database` (the `sessions` table; the cookie holds only an id).
SESSION_DRIVER=cookie
# Minutes of inactivity before a session ends, and how long "remember me" keeps
# someone logged in (43200 = 30 days).
SESSION_LIFETIME=120
REMEMBER_LIFETIME=43200
# The cookie's name: give each app its own when several share a domain.
SESSION_COOKIE=renox_session

# Uploaded files: `local` (STORAGE_PATH/app, public files at /storage/...) or `s3`
# (needs renox's `s3` feature; works with AWS S3, Cloudflare R2 and MinIO).
STORAGE_DISK=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_URL=https://files.example.com
# Largest request body in megabytes.
UPLOAD_MAX_SIZE=10
# Largest live component snapshot in kilobytes (the state a page sends back).
# LIVE_SNAPSHOT_MAX_SIZE=64
# Behind a reverse proxy (Caddy, nginx, a load balancer): its addresses or CIDR
# ranges, so rate limits and the login lock see visitors' IPs from
# X-Forwarded-For. `*` believes whoever connects, for the last hop only.
# TRUSTED_PROXIES=127.0.0.1
# Host names the app answers (comma-separated, `*.example.com` for
# subdomains); requests for other hosts get a 400. APP_URL's host is
# always allowed. Empty: any host.
# TRUSTED_HOSTS=example.com,*.example.com

# Logs: `text` (readable) or `json` (one object per line, for a log service).
# RUST_LOG sets the level, e.g. info,sqlx=warn. LOG_FILE appends to a file
# instead of stdout.
LOG_FORMAT=text
# LOG_FILE=storage/logs/app.log

# Timeouts in seconds. A query waits this long for a free connection:
DATABASE_ACQUIRE_TIMEOUT=5
# Longest a PostgreSQL statement may run (0 = no limit):
DATABASE_STATEMENT_TIMEOUT=30
# Longest a request may take to answer; it then gets a 500 (0 = no limit):
REQUEST_TIMEOUT=60
# Longest sending one mail over SMTP may take:
MAIL_TIMEOUT=10
# With the renox-pdf module: longest making one PDF may take, waiting for a
# free slot included (0 = no limit), and how many are made at once:
# PDF_TIMEOUT=30
# PDF_MAX_CONCURRENT=2

# Content-Security-Policy: `relaxed` (default: inline scripts and Alpine.js work;
# other sites' scripts don't), `strict` (scripts need nonce="{{ csp_nonce() }}";
# Alpine expressions must be simple) or `off` (also `false`, `none`). Allow other
# sites in code with App::csp(|csp| { csp.allow("script-src", "https://…"); }).
CSP=relaxed

# Permissions-Policy: `default` switches off the browser features most apps never use
# (camera, microphone, geolocation, payment, USB...), `off` sends no header, or give
# a header value: geolocation=(self), camera=(). Origins go in quotes. Allow a feature
# in code with App::permissions_policy(|p| { p.allow("geolocation", "self"); }).
PERMISSIONS_POLICY=default

# Search engines and analytics, used only when APP_ENV=production (elsewhere
# pages say noindex and robots.txt disallows everything).
GOOGLE_SITE_VERIFICATION=
GA4_MEASUREMENT_ID=
# For events sent from the server (renox::analytics::ServerEvent).
GA4_API_SECRET=
GTM_CONTAINER_ID=

# Language used for texts missing in the visitor's language.
APP_FALLBACK_LOCALE=en

# Where views, translations, public files and storage live, relative to the
# directory the app runs from (these are the defaults).
# VIEWS_PATH=resources/views
# LANG_PATH=resources/lang
# PUBLIC_PATH=public
# STORAGE_PATH=storage

# Payments (renox-billing), only when the app uses it. Fake values: put your own keys here,
# never in the repository. A named account appends its name: STRIPE_SECRET_ACME_LLC.
# STRIPE_SECRET=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_PRO=price_replace_me
# XENDIT_SECRET_KEY=xnd_development_replace_me
# XENDIT_CALLBACK_TOKEN=replace_me
# NGENIUS_API_KEY=replace_me
# NGENIUS_OUTLET_REF=00000000-0000-0000-0000-000000000000
# NGENIUS_WEBHOOK_SECRET=replace_me
