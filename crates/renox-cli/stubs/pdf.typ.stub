// {{title}}: a PDF template for renox-pdf. Render it with
//
//     let pdf = Pdf::document(&state, "{{name}}")?
//         .locale(&lang)          // "en", "ar", ... sets language and direction
//         .data(&data)            // read below as `data`
//         .render(&state)
//         .await?;
//
// Lay it out with `start` / `end` (never left / right) and it reads right in
// English and in Arabic. Texts the app translates come in through
// `data.labels`; the English ones below are the fallback.
#import "@renox/kit:0.1.0": *

#show: base
#set page(paper: "a4", margin: (x: 18mm, y: 16mm))

#let label(key, default) = data.at("labels", default: (:)).at(key, default: default)

#page-header(
  data.at("title", default: label("title", "{{title}}")),
  subtitle: data.at("customer", default: none),
  meta: (
    (label("number", "Number"), data.at("number", default: "0001")),
    (label("date", "Date"), date(data.at("date", default: "2026-01-01"))),
  ),
)

// Lines: (name, quantity, price in cents). `money` formats cents in the
// document's language and the currency in `data.currency` (USD by default).
#let currency = data.at("currency", default: "USD")
#let items = data.at("items", default: ())
#let total = items.map(i => i.quantity * i.price).sum(default: 0)

#data-table(
  (label("item", "Item"), label("quantity", "Qty"), label("price", "Price"), label("amount", "Amount")),
  items.map(i => (
    i.name,
    str(i.quantity),
    money(i.price, currency: currency),
    money(i.quantity * i.price, currency: currency),
  )),
  aligns: (start, end, end, end),
  widths: (1fr, auto, auto, auto),
  footer: ("", "", label("total", "Total"), money(total, currency: currency)),
)

#v(spacing.lg)
#text(fill: colors.muted, size: sizes.small, data.at("note", default: ""))
