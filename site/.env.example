# The documentation site. Its pages are compiled in; it keeps no data, but
# Renox wants a database file for its own tables (sessions, cache).
APP_NAME=Renox
APP_ENV=local
APP_URL=http://127.0.0.1:3000
# APP_KEY=   # required in production: rnx key:generate
DATABASE_URL=sqlite://storage/site.db
# Nothing to queue or schedule.
QUEUE_WORKERS=0
SCHEDULER=false
